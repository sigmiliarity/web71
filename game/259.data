Q␀0,~␀&}␀ЂB‰␀0
Q␀@Њ␀ЂB‰␀0‰V␀Ђ i␀Q␀@Hѓ␀ Q␀␀␀Ђ/ScriptOutput␀␀␀␀␀␀␀␀local function ttFixupLua51Script( t --[[ Why, Robert Oates? Why? --]] )
    if t:find('--FIXUP 5.1',1,true) then return t end
    if not t:find('%f[%w_]arg%f[%W_]') then return t end
    local n1, n2, n3
    t, n1 = t:gsub('%f[%w]function%s+[_%w.:]+%s*%([%s_%w,.]*%.%.%.%s*%)','%0 local arg={n=select(\"#\",...),...}')
    t, n2 = t:gsub('%f[%w]function%s*%([%s_%w,.]*%.%.%.%s*%)','%0 local arg={n=select(\"#\",...),...}')
    t, n3 = t:gsub('%f[%w]function%s+[_%w.:]+%s*%([%s_%w,.]*%.%.%.%s*%-%-%[%[[^]]*%]%]%s*%)','%0 local arg={n=select(\"#\",...),...}')
    local bChanged = n1 + n2 + n3 > 0
    if bChanged then t = '--FIXUP 5.1; Please refactor code in this file not to use the arg parameter for var-arg functions\n'..t end
    return t, bChanged
end

local function ttFixupLua50Script( t )                                           
    local n, bChanged
    t, n = t:gsub("%f[%w]for ([ %w,_]+) in +([%w_.]+) +do%f[%W]", "for %1 in pairs( %2 ) do");
    t, bChanged = ttFixupLua51Script(t);                                                              
    return (bChanged or n > 0) and t
end

return ttFixupLua50Script␀␀␀␀%s expected, got %s␀°€Н␀␀њ@␀␀ЫQ␀Ђдj␀ђщQ␀Ђдj␀Ђдj␀Ђдj␀°чG␀РчG␀ђчG␀а›@␀interval is empty␀␀␀wrong number of arguments␀␀␀wМ+2bt␀␀Ў?UUUUUUХ?ь€Н␀PгQ␀P‚K␀P‚K␀РЂb␀Pй…␀mPhi␀␀␀␀mTheta␀␀mR␀␀%s:%d: %s␀␀␀њ‰Н␀ркQ␀␀ҐW␀Pч@␀ ·Њ␀P7”␀`±C␀ ±C␀PЇC␀pЇC␀а±C␀ђЇC␀°ЇC␀@\ ␀␀’†␀Ђдj␀ЂB‰␀`]Z␀Ђ­c␀ ]Z␀°ЩS␀pЭњ␀и‰Н␀ђлQ␀␀ҐW␀Pч@␀ ·Њ␀P7”␀`±C␀ ±C␀PЇC␀pЇC␀а±C␀ђЇC␀°ЇC␀@\ ␀␀’†␀Ђдj␀ЂB‰␀ђжQ␀РйQ␀Po␀␀иQ␀реQ␀mPriority␀␀␀mLoops␀␀mAdditiveMix␀␀␀␀mSoundVolume␀␀␀␀mContribution␀␀␀mTime␀␀␀__tostring␀␀__ttg_RichError␀line␀␀␀␀file␀␀␀␀message␀: ␀␀...␀Unencrypted: %s␀@␀␀␀Couldn't read file: %s␀␀ttSetErrorOnGlobalCreation␀␀OnSetupAgent␀␀␀␀hbm␀
